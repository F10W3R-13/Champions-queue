# ===== Secrets (never commit) =====
# Broad match so .env / .env.local / .env.production all stay out.
.env
.env.*
!.env.example

# ===== Python =====
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ===== Virtual environments =====
venv/
env/
ENV/
env.bak/
venv.bak/
.venv/

# ===== Runtime state (bot-generated) =====
# bot.log covered by *.log below; runtime JSON state must not be committed.
mmr_state.json
*.state.json
*.sqlite
*.sqlite3
*.db
*.cache
*.pid

# ===== Logs & backups =====
*.log
*.bak
*.swp
*.swo
*~

# ===== Windows artifacts =====
# `nul` is a Windows device name that can become a real 0-byte junk file.
nul
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# ===== macOS / Linux artifacts =====
.DS_Store
.AppleDouble
.LSOverride
._*

# ===== IDE / editors =====
.vscode/
.idea/
*.iml
*.ipr
*.iws
.project
.pydevproject
.settings/
*.sublime-workspace
*.sublime-project

# ===== Testing / coverage =====
.tox/
.nox/
.coverage
.coverage.*
.cache
.pytest_cache/
nosetests.xml
coverage.xml
*.cover
.hypothesis/
htmlcov/

# ===== Type checkers =====
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/

# ===== Jupyter =====
.ipynb_checkpoints

# ===== Profiling =====
*.prof
*.cprof
